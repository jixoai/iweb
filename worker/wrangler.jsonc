// 用户原始需求（2026-08-11）：以 celld 替代 Edge Runtime，承载单个家庭节点的计算能力。
{
  "name": "iweb-node",
  "main": "index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "admin-assets",
    "binding": "ADMIN_ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "NOTES_CELL", "class_name": "NotesCell" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppCell"] },
    { "tag": "v2", "new_sqlite_classes": ["NotesCell"] }
  ]
}
