{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::iweb-cells-admin",
        "arn:aws:s3:::iweb-cells-mcp",
        "arn:aws:s3:::iweb-cells-notes",
        "arn:aws:s3:::iweb-cells-hello",
        "arn:aws:s3:::iweb-cells-search",
        "arn:aws:s3:::iweb-cells-collab"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::iweb-cells-admin/*",
        "arn:aws:s3:::iweb-cells-mcp/*",
        "arn:aws:s3:::iweb-cells-notes/*",
        "arn:aws:s3:::iweb-cells-hello/*",
        "arn:aws:s3:::iweb-cells-search/*",
        "arn:aws:s3:::iweb-cells-collab/*"
      ]
    }
  ]
}
