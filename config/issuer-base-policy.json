{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
    "Resource": [
      "arn:aws:s3:::iweb-app-*",
      "arn:aws:s3:::iweb-app-*/*",
      "arn:aws:s3:::iweb-apps",
      "arn:aws:s3:::iweb-apps/*"
    ]
  }, {
    "Effect": "Allow",
    "Action": ["s3:GetObject", "s3:ListBucket"],
    "Resource": [
      "arn:aws:s3:::iweb-system",
      "arn:aws:s3:::iweb-system/packages/*"
    ]
  }]
}
