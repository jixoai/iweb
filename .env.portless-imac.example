# 用户原始需求（2026-08-12）：从开发机用 Portless 访问运行在 iMac 上的 iweb 节点。
# 正交意图：声明远端节点；声明本地转发；声明 Portless 开发域名。

# Portless 公开的本地 HTTPS 域名，同时必须与 iMac 容器的 IWEB_BASE_HOST 一致。
IWEB_BASE_HOST=test.iweb.localhost

# iMac 上 Docker 发布的 Kernel HTTP 端口（Caddy 已废除，入口由 Kernel 拥有）。
# IP 比 .local 名称更适合稳定脚本调用。
IWEB_REMOTE_HOST=192.168.2.13
IWEB_REMOTE_PORT=9010

# 仅绑定在开发机 127.0.0.1，Portless alias 将转发到此端口。
IWEB_LOCAL_FORWARD_PORT=19010

# Bun 脚本通过 SSH 建立私有本地转发；此主机名应与 known_hosts 中的条目一致。
IWEB_SSH_USER=kzf
IWEB_SSH_HOST=bngjdemac-mini-7.local
IWEB_SSH_PORT=22
# IWEB_SSH_IDENTITY_FILE=/Users/you/.ssh/id_ed25519

# `up` 命令通过本机 Docker context 在 iMac 构建并启动 Compose。
# `connect` 仅连接已运行的 iweb，不会重新部署。
IWEB_DOCKER_CONTEXT=remote-mini

# Portless 的 wildcard 设置是全局代理设置。设为 0 仅在代理已处于 wildcard 模式时使用。
IWEB_PORTLESS_RESTART=1
