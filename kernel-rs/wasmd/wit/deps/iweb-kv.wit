// 用户原始需求（2026-08-27，add-wasm-host-services 契约层先行）：iweb 自有 KV 宿主接口 `iweb:kv@1.0.0` 必须与规范逐字一致。
// wasmd 侧语法修正（2026-08-27，add-wasm-host-services 任务 5.6；相对 spec 代码块的两处偏差，均已上报）：
// - `list` 是 WIT 保留字：函数名按 WIT 关键字转义语法写成 `%list`（语义名仍是 list；design §5 方法对 kv:list 不变）。
// owner 已裁决（design.md「Owner Decisions Ratified」）：K1=包含有界 list(prefix,cursor,limit)；K2=单 key 线性化 CAS + delete tombstone；
// Q1=共享 resources.storageBytes envelope。宿主侧只允许 import store（export store 一律 IWEB_KV_WIT_DIRECTION_INVALID）。
// 规范权威：openspec/changes/add-wasm-host-services/specs/wasm-host-kv/spec.md；
// tests/wasm-host-kv.test.ts 断言本文件（剥注释后）与 spec 的 wit 代码块逐字一致。
package iweb:kv@1.0.0;

interface store {
  type key = string;
  type value = list<u8>;
  type version = u64;

  record item { key: key, value: value, version: version }
  record page { items: list<item>, next-cursor: option<string> }

  variant error {
    invalid-key,
    not-found,
    conflict,
    quota-exceeded,
    limit-exceeded,
    cursor-expired,
    unavailable,
    internal,
  }

  get: func(key: key) -> result<item, error>;
  set: func(key: key, value: value, expected: option<version>) -> result<version, error>;
  delete: func(key: key, expected: option<version>) -> result<version, error>;
  %list: func(prefix: string, cursor: option<string>, limit: u32) -> result<page, error>;
}

world kv { import store; }
