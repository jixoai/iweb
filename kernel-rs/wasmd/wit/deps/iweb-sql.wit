// 用户原始需求（2026-08-27，add-wasm-host-services 契约层先行）：iweb 自有 SQL 宿主接口 `iweb:sql@1.0.0` 必须与规范逐字一致。
// wasmd 侧语法修正（2026-08-27，add-wasm-host-services 任务 5.6；相对 spec 代码块的三处偏差，均已上报）：
// - `type value = variant {...}` 不是合法 WIT（type 别名不能指向匿名 variant）：改为具名 `variant value {...}`；
// - `result` 是 WIT 保留字，且 `%result` 生成的 Rust `struct Result` 与 wit-bindgen
//   自身生成的 `Result<T, E>` 用法自冲突（wasmtime 48.0.1 实证无法编译）：record 改名
//   `query-result`（component 面向 ABI 的类型名随之变化；语义形状不变，上报 owner）；
// - `float64` 在现行 wit-parser 已更名为 `f64`（同一类型的改名，非语义变化）。
// owner 已裁决（design.md「Owner Decisions Ratified」）：S1=minimal-sqlite-v1（单语句、参数化、per-call 隐式事务）；
// S2 关闭为「单调用隐式事务、无跨调用事务句柄」，宿主绝不从分号文本推断批处理。
// 宿主侧只允许 import store（export store 一律 IWEB_SQL_WIT_DIRECTION_INVALID；iweb:sql@1.0.1 等非 1.0.0 版本同样拒绝）。
// 规范权威：openspec/changes/add-wasm-host-services/specs/wasm-host-sql/spec.md；
// tests/wasm-host-sql.test.ts 断言本文件（剥注释后）与 spec 的 wit 代码块逐字一致。
package iweb:sql@1.0.0;

interface store {
  variant value { null, integer(s64), real(f64), text(string), blob(list<u8>) }
  record parameter { value: value }
  record column { name: string, value: value }
  record row { columns: list<column> }
  record query-result { rows: list<row>, affected: u64, last-insert-id: option<u64> }

  variant error {
    invalid-sql,
    invalid-parameter,
    constraint,
    busy,
    quota-exceeded,
    limit-exceeded,
    unavailable,
    internal,
  }

  execute: func(statement: string, parameters: list<parameter>) -> result<query-result, error>;
}

world sql { import store; }
