// 用户原始需求（2026-08-25，add-wasm-runtime 任务 1.3）：iweb 自有 WIT 宿主接口必须与规范逐字一致。
// owner 终裁（2026-08-26）：值为 string、closed error variant、无 list/write/enumeration/error-detail；
// 宿主侧只允许 import store（export store 一律 IWEB_SECRET_WIT_DIRECTION_INVALID）。
// 规范权威：openspec/changes/add-wasm-runtime/specs/wasm-application-runtime/spec.md；
// tests/wasm-host-store.test.ts 断言本文件（剥注释后）与 spec 的 wit 代码块逐字一致。
package iweb:secrets@1.0.0;

interface store {
  type key = string;
  variant error {
    not-assigned,
    denied,
    snapshot-expired,
    revision-stale,
    internal,
  }
  get: func(key: key) -> result<string, error>;
}

world secrets {
  import store;
}
