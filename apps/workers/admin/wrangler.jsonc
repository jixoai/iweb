// 用户原始需求（2026-08-15）：admin 必须是普通的 celld 应用：独立项目、独立部署桶、独立进程与身份，不再与其它应用共享一个 Worker。
// 正交意图：ADMIN_ASSETS 绑定留在本应用项目内（celld v0.2 要求 assets.directory 位于项目根内）；run_worker_first 保持 Dispatcher 时代的资源语义。
{
  "name": "iweb-admin",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "admin-assets",
    "binding": "ADMIN_ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
