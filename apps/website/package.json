{
	"name": "website",
	"version": "0.0.0",
	"private": true,
	"description": "iweb 官方静态站点（jixoai 设计语言、GitHub Pages 交付）；零 runtime 依赖，全部为构建期工具链。",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 13222",
		"build": "vite build && node scripts/postbuild.mjs",
		"preview": "vite preview",
		"check": "node scripts/check-static.mjs",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/share-tech-mono": "^5.2.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"clsx": "^2.1.1",
		"svelte": "^5.56.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"vite": "^8.0.16"
	}
}
